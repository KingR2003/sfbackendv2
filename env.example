# SF App Backend Environment Configuration (Example)
# Rename this file to .env and fill in your actual values.

# AWS Configuration (Used in application.properties)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET_NAME=deliveryapp-product-images-2026

# Database Configuration (Overrides if needed in properties)
DB_URL=jdbc:mysql://localhost:3306/live?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=123

# JWT Configuration
JWT_SECRET=mySecretKeyForJWTTokenGenerationAndValidationPurposeOnly
JWT_EXPIRATION=86400000

# Application Port
PORT=8080
