# Frontend Base URL Configuration (.env.example)
# Copy this to .env and update values for your environment

# Frontend Base URL - used for email links and full-path redirects
# For local development:
VITE_APP_BASE_URL=http://localhost:8080/svasthya/admin-side

# For production:
# VITE_APP_BASE_URL=https://yourdomain.com/svasthya/admin-side

# Base path that must match vite.config.ts base setting
VITE_APP_BASE_PATH=/svasthya/admin-side

# Backend API Configuration
# The API backend URL (should match vite.config.ts proxy target)
VITE_API_BASE_URL=http://3.111.157.226
